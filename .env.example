# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Cuelinks Monetization Configuration
# Create an API Key in Cuelinks dashboard with scopes:
# - read:campaigns (to discover active merchant campaigns via GET /pub_api/v3/campaigns)
# - write:links (to convert merchant URLs via POST /pub_api/v3/links/convert)
CUELINKS_API_KEY=your-cuelinks-api-key-here
# Your Cuelinks Publisher ID (from https://www.cuelinks.com dashboard)
CUELINKS_PUBLISHER_ID=your-cuelinks-publisher-id
# Optional Campaign/Channel ID for SubID tracking
CUELINKS_CAMPAIGN_ID=

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Site Configuration
SITE_NAME=SmartPick Reviews
SITE_URL=https://yoursite.com
OUTPUT_DIR=./output
SITE_OUTPUT_DIR=./site_output
